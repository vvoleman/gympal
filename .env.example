# GymPal environment example
# Copy this file to `.env` or create `.env.development`, `.env.release`, or `.env.local` as needed.
# Values here are examples and should be replaced with your real credentials.

# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional: Any additional keys with the GP_ prefix will be exposed automatically via BuildKonfig
# and available in common code as BuildKonfig.GP_SOME_KEY
# GP_API_BASE_URL=https://api.example.com
# GP_FEATURE_FLAG_EXPERIMENT_X=true
